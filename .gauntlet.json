  "runtime": {
    "enabled": true,
    "schema": "egrt.runtime.v1",
    "persist_raw_prompts": false,
    "persist_raw_tool_output": false,
    "release_gate": true,
    "active_task_required_for_gate": true,
    "strict_active_task": false,
    "automatic_task_supersession": true,
    "automatic_graph_revision": true,
    "automatic_route_all_ready": true,
