    "docs/specs/CHALLENGE_ENGINEERING_SPEC.md",
    "skills/soul/SKILL.md",
    "skills/mathbot/SKILL.md",
    "skills/scoutbot/SKILL.md",
    "skills/novelbot/SKILL.md",
    "skills/codebot/SKILL.md",
    "skills/benchbot/SKILL.md",
    "skills/infinity-gauntlet/SKILL.md",
    "skills/meditate/SKILL.md",
    "skills/council-of-elders/SKILL.md",
    "skills/foil/SKILL.md"
