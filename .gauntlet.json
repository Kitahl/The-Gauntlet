{
  "state_dir": ".egrt/state",
  "governing_files": [
    "README.md",
    "RESEARCH.md",
    "REPRODUCIBILITY.md",
    "ROADMAP.md",
    "docs/ARCHITECTURE.md",
    "docs/VNEXT_RUNTIME_PIPELINE.md",
