+                obligation_set_hash=refuted.obligation_set_hash,
+                resolver="mind",
+            ))
+            self.assertEqual(challenge_gate(root2, refuted.task_id, refuted.obligation_id, mode="enforced")[0], Verdict.ISSUE)
