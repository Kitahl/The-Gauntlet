{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {"type": "command", "command": "python", "args": ["${CLAUDE_PROJECT_DIR}/tools/gauntlet_monitor.py", "snapshot"], "timeout": 10},
          {"type": "command", "command": "python", "args": ["${CLAUDE_PROJECT_DIR}/tools/gauntlet_boundary.py", "reset"], "timeout": 10},
          {"type": "command", "command": "python", "args": ["${CLAUDE_PROJECT_DIR}/tools/foil_hook.py", "session"], "timeout": 10}
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {"type": "command", "command": "python", "args": ["${CLAUDE_PROJECT_DIR}/tools/foil_hook.py", "prompt"], "timeout": 10}
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {"type": "command", "command": "python", "args": ["${CLAUDE_PROJECT_DIR}/tools/gauntlet_hook.py", "pre-tool"], "timeout": 20}
        ]
      },
      {
        "matcher": "Edit|Write|NotebookEdit",
        "hooks": [
          {"type": "command", "command": "python", "args": ["${CLAUDE_PROJECT_DIR}/tools/gauntlet_hook.py", "pre-write"], "timeout": 10}
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {"type": "command", "command": "python", "args": ["${CLAUDE_PROJECT_DIR}/tools/gauntlet_hook.py", "post-tool"], "timeout": 10}
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {"type": "command", "command": "python", "args": ["${CLAUDE_PROJECT_DIR}/tools/gauntlet_boundary.py"], "timeout": 45}
        ]
      }
    ]
  }
}
